      <aliases enabled='yes' />
      <column caption='Area ha' datatype='real' name='[Area_ha]' role='measure' type='quantitative' />
      <column caption='Total Production Tonnes' datatype='real' name='[Calculation_1591863589810176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Area_ha] * [Yield_kg_per_ha]) / 1000' />
      </column>
      <column caption='Total NPK' datatype='real' name='[Calculation_1591863589957633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total_N_kg] + [Total_P_kg] + [Total_K_kg]' />
      </column>
      <column caption='Input Efficiency' datatype='real' name='[Calculation_1591863590043650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1591863589957633]) / SUM([Area_ha])' />
      </column>
      <column caption='NPK Balance Index' datatype='real' name='[Calculation_1591863590174723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([N_req_kg_per_ha] +&#13;&#10; [P_req_kg_per_ha] +&#13;&#10; [K_req_kg_per_ha]) / 3' />
      </column>
      <column caption='Rainfall Bin' datatype='integer' name='[Calculation_1591863590289412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([Rainfall_mm]/100)*100' />
      </column>
      <column caption='pH Bin' datatype='real' name='[Calculation_1591863590359045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([pH],1)' />
      </column>
      <column caption='Yield LOD' datatype='real' name='[Calculation_1591863590445062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State Name],[Crop] :&#13;&#10;AVG([Yield_kg_per_ha]) }' />
      </column>
      <column caption='NPK Efficiency LOD' datatype='real' name='[Calculation_1591863590543367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State Name] :&#13;&#10;SUM([Total_N_kg]+[Total_P_kg]+[Total_K_kg])&#13;&#10;/&#13;&#10;SUM([Area_ha]) }' />
      </column>
      <column caption='Dynamic Metric Calculation' datatype='real' name='[Calculation_1591863591198729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1591863590600712]&#13;&#10;&#13;&#10;WHEN &quot;Yield&quot;&#13;&#10;THEN AVG([Yield_kg_per_ha])&#13;&#10;&#13;&#10;WHEN &quot;Production&quot;&#13;&#10;THEN SUM([Calculation_1591863589810176])&#13;&#10;&#13;&#10;WHEN &quot;Rainfall&quot;&#13;&#10;THEN AVG([Rainfall_mm])&#13;&#10;&#13;&#10;WHEN &quot;Temperature&quot;&#13;&#10;THEN AVG([Temperature_C])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='YoY Growth %' datatype='real' name='[Calculation_1591863592640522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;AVG([Yield_kg_per_ha])&#13;&#10;-&#13;&#10;LOOKUP(AVG([Yield_kg_per_ha]),-1)&#13;&#10;)&#13;&#10;/&#13;&#10;LOOKUP(AVG([Yield_kg_per_ha]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CAGR' datatype='real' name='[Calculation_1591863593005068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;POWER(&#13;&#10;WINDOW_MAX(AVG([Yield_kg_per_ha]))&#13;&#10;/&#13;&#10;WINDOW_MIN(AVG([Yield_kg_per_ha])),&#13;&#10;1&#13;&#10;/&#13;&#10;(&#13;&#10;WINDOW_MAX(MIN([Year]))&#13;&#10;-&#13;&#10;WINDOW_MIN(MIN([Year]))&#13;&#10;)&#13;&#10;)&#13;&#10;)-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative Production %' datatype='real' name='[Calculation_1591863611379726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1591863589810176]))&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM([Calculation_1591863589810176]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='State  no' datatype='integer' name='[Calculation_1647938719354880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([State Name])' />
      </column>
      <column datatype='integer' name='[Dist Code]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Dist Name]' role='dimension' type='nominal' />
      <column caption='Humidity %' datatype='integer' name='[Humidity_%]' role='measure' type='quantitative' />
      <column caption='K req kg per ha' datatype='real' name='[K_req_kg_per_ha]' role='measure' type='quantitative' />
      <column caption='N req kg per ha' datatype='real' name='[N_req_kg_per_ha]' role='measure' type='quantitative' />
      <column caption='P req kg per ha' datatype='real' name='[P_req_kg_per_ha]' role='measure' type='quantitative' />
      <column caption='Rainfall mm' datatype='integer' name='[Rainfall_mm]' role='measure' type='quantitative' />
      <column caption='Solar Radiation MJ m2 day' datatype='integer' name='[Solar_Radiation_MJ_m2_day]' role='dimension' type='quantitative' />
      <column datatype='integer' name='[State Code]' role='dimension' type='ordinal' />
      <column datatype='string' name='[State Name]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='Temperature C' datatype='integer' name='[Temperature_C]' role='measure' type='quantitative' />
      <column caption='Total K kg' datatype='real' name='[Total_K_kg]' role='measure' type='quantitative' />
      <column caption='Total N kg' datatype='real' name='[Total_N_kg]' role='measure' type='quantitative' />
      <column caption='Total P kg' datatype='real' name='[Total_P_kg]' role='measure' type='quantitative' />
      <column caption='Wind Speed m s' datatype='real' name='[Wind_Speed_m_s]' role='measure' type='quantitative' />
