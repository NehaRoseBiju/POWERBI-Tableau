    <worksheet name='Dynamic Metric Switcher KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom_Crops_yield_Historical_Dataset' name='federated.1h7x16m17tkela14l5e9k0kcdq58' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selector' datatype='string' name='[Parameter 1591863590600712]' param-domain-type='list' role='measure' type='nominal' value='&quot;Yield&quot;'>
              <calculation class='tableau' formula='&quot;Yield&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h7x16m17tkela14l5e9k0kcdq58'>
            <column caption='Area ha' datatype='real' name='[Area_ha]' role='measure' type='quantitative' />
            <column caption='Total Production Tonnes' datatype='real' name='[Calculation_1591863589810176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Area_ha] * [Yield_kg_per_ha]) / 1000' />
            </column>
            <column caption='Dynamic Metric Calculation' datatype='real' name='[Calculation_1591863591198729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1591863590600712]&#13;&#10;&#13;&#10;WHEN &quot;Yield&quot;&#13;&#10;THEN AVG([Yield_kg_per_ha])&#13;&#10;&#13;&#10;WHEN &quot;Production&quot;&#13;&#10;THEN SUM([Calculation_1591863589810176])&#13;&#10;&#13;&#10;WHEN &quot;Rainfall&quot;&#13;&#10;THEN AVG([Rainfall_mm])&#13;&#10;&#13;&#10;WHEN &quot;Temperature&quot;&#13;&#10;THEN AVG([Temperature_C])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Rainfall mm' datatype='integer' name='[Rainfall_mm]' role='measure' type='quantitative' />
            <column datatype='string' name='[State Name]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Temperature C' datatype='integer' name='[Temperature_C]' role='measure' type='quantitative' />
            <column caption='Yield kg per ha' datatype='real' name='[Yield_kg_per_ha]' role='measure' type='quantitative' />
            <column-instance column='[State Name]' derivation='None' name='[none:State Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1591863591198729]' derivation='User' name='[usr:Calculation_1591863591198729:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
